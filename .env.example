# =========================================================================
# FA Events — Web Cloud Storage Configuration (.env)
# =========================================================================

# -------------------------------------------------------------------------
# Option 1: Cloudinary Storage (Ideal for Photos, Videos & Unlimited CDN)
# Get credentials at: https://cloudinary.com/console
# -------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# -------------------------------------------------------------------------
# Option 2: Firebase Storage (Google Cloud Storage)
# Place 'firebase_key.json' in project root OR specify credentials path
# -------------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=firebase_key.json
FIREBASE_STORAGE_BUCKET=fa-events-7fb4b.appspot.com

# -------------------------------------------------------------------------
# Web App Security
# -------------------------------------------------------------------------
FA_SECRET_KEY=change-this-to-a-strong-random-secret-key
